# Azure Auth
VITE_AZURE_CLIENT_ID=your_client_id
VITE_AZURE_TENANT_ID=your_tenant_id

# Azure Cosmos DB
VITE_AZURE_COSMOS_CONNECTION_STRING=your_cosmos_connection_string

# Azure Blob Storage
VITE_AZURE_STORAGE_CONNECTION_STRING=your_storage_connection_string
VITE_AZURE_STORAGE_ACCOUNT=your_storage_account_name

# Azure Computer Vision
VITE_AZURE_VISION_API_KEY=your_vision_api_key
VITE_AZURE_VISION_ENDPOINT=https://your-resource.cognitiveservices.azure.com

# JWT
VITE_JWT_SECRET=your_jwt_secret_min_32_chars

# Google Vision (backup)
VITE_GOOGLE_VISION_API_KEY=your_google_vision_key