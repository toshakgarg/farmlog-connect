# ── Vision AI Provider Selection ────────────────────────────────────
# Options: gemini | openai | azure | anthropic
# "gemini" is recommended for FREE scanning via Google AI Studio API key.
VISION_PROVIDER=gemini

# ── Google Gemini (Free tier available via Google AI Studio) ───────
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.5-flash

# ── OpenAI ─────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-YOUR_KEY_HERE
OPENAI_MODEL=gpt-4o-mini

# ── Claude / Anthropic ─────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-YOUR_KEY_HERE
CLAUDE_MODEL=claude-sonnet-4-6

# ── Azure Cosmos DB ────────────────────────────────────────────────
# From Azure Portal → your Cosmos account → Keys
COSMOS_ENDPOINT=https://farmlog-db.documents.azure.com:443/
COSMOS_KEY=YOUR_PRIMARY_KEY_HERE
COSMOS_DATABASE=form-intelligence

# ── Azure Blob Storage ─────────────────────────────────────────────
# From Azure Portal → Storage account → Access keys → Connection string
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=farmlogfiles;AccountKey=YOUR_KEY;EndpointSuffix=core.windows.net
BLOB_CONTAINER_BLANK=blank-forms
BLOB_CONTAINER_FILLED=filled-forms

# ── API config ─────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173,https://farmlog-connect.vercel.app
API_HOST=0.0.0.0
API_PORT=8000

# ── Pipeline config ────────────────────────────────────────────────
CONFIDENCE_THRESHOLD=60          # below this % → flag for review
MAX_PHOTOS_PER_BATCH=10
MAX_IMAGE_SIZE_MB=10
